{
  "name": "kindle-tradutor",
  "version": "0.1.0",
  "private": true,
  "description": "Extensão Chrome: tradução de trechos no Kindle Web via página do ChatGPT (sem API).",
  "scripts": {
    "icons": "node scripts/make-icons.js",
    "build:test-ext": "node scripts/build-test-extension.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=180000 test/e2e/extension.test.js",
    "test:e2e:headed": "HEADED=1 npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
