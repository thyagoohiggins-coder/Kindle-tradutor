{
  "manifest_version": 3,
  "name": "Kindle Tradutor (ChatGPT)",
  "version": "0.2.0",
  "description": "Selecione um trecho no Kindle Web e veja a tradução, a divisão por expressões e uma nota explicativa, geradas pelo ChatGPT na sua própria conta (sem API).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "https://read.amazon.com/*",
    "https://read.amazon.com.br/*",
    "https://ler.amazon.com.br/*",
    "https://read.amazon.co.uk/*",
    "https://read.amazon.ca/*",
    "https://read.amazon.com.au/*",
    "https://read.amazon.in/*",
    "https://read.amazon.co.jp/*",
    "https://read.amazon.de/*",
    "https://lesen.amazon.de/*",
    "https://leer.amazon.es/*",
    "https://lire.amazon.fr/*",
    "https://leggi.amazon.it/*",
    "https://read.amazon.com.mx/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Kindle Tradutor: opções"
  },
  "content_scripts": [
    {
      "matches": [
        "https://read.amazon.com/*",
        "https://read.amazon.com.br/*",
        "https://ler.amazon.com.br/*",
        "https://read.amazon.co.uk/*",
        "https://read.amazon.ca/*",
        "https://read.amazon.com.au/*",
        "https://read.amazon.in/*",
        "https://read.amazon.co.jp/*",
        "https://read.amazon.de/*",
        "https://lesen.amazon.de/*",
        "https://leer.amazon.es/*",
        "https://lire.amazon.fr/*",
        "https://leggi.amazon.it/*",
        "https://read.amazon.com.mx/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/kindle/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/chatgpt/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}
